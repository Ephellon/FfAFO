# Copy to .env and fill in what you use. .env is git-ignored; real environment variables override it.

# Folder for the FAFO fingerprint index (default: FAFO/ next to the code). Keep it outside your music library.
FAFO_DIR=

# Spotify Web API client credentials (https://developer.spotify.com/dashboard). Optional: without them
# Spotify is skipped and Apple Music is the reference.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
